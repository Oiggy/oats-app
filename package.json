{
  "name": "oats-app",
  "version": "1.0.0",
  "description": "Offline Assessment Task Suite - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "verify-data": "node scripts/verify-assets.js",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "keywords": [
    "assessment",
    "offline",
    "desktop",
    "electron"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.yourcompany.oats",
    "productName": "OATS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "fft-js": "^0.0.12",
    "node-record-lpcm16": "^1.0.1",
    "wav": "^1.0.2"
  }
}
