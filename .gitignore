# --- OS junk ---
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini

# --- Logs & runtime ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# --- Node / tooling caches ---
node_modules/
.npm/
.pnpm-store/
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.nyc_output/

# --- Env files (keep an .env.example committed) ---
.env
.env.*
!.env.example

# --- Build outputs (any packager: electron-builder / forge / packager) ---
dist/
build/
release/
out/
make/
packages/
**/*-unpacked/
**/*.asar

# Common packaged artifacts (don’t commit installers)
*.exe
*.msi
*.dmg
*.pkg
*.snap
*.AppImage
*.deb
*.rpm
*.zip
*.7z
*.tar.gz
*.blockmap

# Auto-update artifacts generated by electron-builder (publish to Releases, not git)
latest.yml
latest-linux.yml
latest-mac.yml
builder-debug.yml
dev-app-update.yml

# Squirrel.Windows artifacts (if you ever use Squirrel)
RELEASES
*.nupkg
*-delta.nupkg
*-full.nupkg

# --- Test & coverage ---
coverage/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# --- TypeScript (if used) ---
*.tsbuildinfo

# --- Bundlers (pick what applies; harmless if unused) ---
stats.json
public/build/
.vite/
node_modules/.vite/

# --- IDE / editor ---
.vscode/
.idea/
*.iml

# --- Temporary folders you might use locally ---
tmp/
temp/
